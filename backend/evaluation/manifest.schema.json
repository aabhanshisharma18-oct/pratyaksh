{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pratyaksh.local/contracts/d1-image-evaluation-manifest-1.1.json",
  "title": "Pratyaksh D1 image evaluation manifest",
  "type": "object",
  "required": ["schema_version", "name", "created_at", "samples"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "name": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "sample_id", "path", "sha256", "label", "split", "group_id",
          "media_type", "manipulation_type", "ground_truth", "source",
          "terms", "transformation"
        ],
        "properties": {
          "sample_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "label": {"enum": ["genuine", "synthetic"]},
          "split": {"enum": ["development", "test"]},
          "group_id": {"type": "string", "minLength": 1},
          "media_type": {"const": "image"},
          "manipulation_type": {"type": "string", "minLength": 1},
          "ground_truth": {
            "type": "object",
            "required": ["basis"],
            "properties": {"basis": {"type": "string", "minLength": 1}}
          },
          "source": {"type": "string", "minLength": 1},
          "terms": {"type": "string", "minLength": 1},
          "transformation": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
