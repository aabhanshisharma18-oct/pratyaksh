{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pratyaksh.local/schemas/dashboard-finding-1.1.json",
  "title": "Pratyaksh dashboard finding 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","finding_id","run_id","evidence_id","category","execution_status","result","observation","method","method_version","scope","score","location","support_refs","limitations","review_status","error","details","fixture"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "finding_id": {"type":"string","pattern":"^F-[0-9a-f]+$"},
    "run_id": {"type":"string","pattern":"^RUN-[0-9a-f]+$"},
    "evidence_id": {"type":"string","minLength":1},
    "category": {"enum":["synthetic_media","tampering","integrity","provenance"]},
    "execution_status": {"enum":["queued","running","completed","failed","unsupported","not_applicable","cancelled"]},
    "result": {"type":["string","null"],"enum":["indicators_detected","no_indicators_detected","inconclusive",null]},
    "observation": {"type":"string","minLength":1},
    "method": {"type":"string","minLength":1},
    "method_version": {"type":"string","pattern":"^fixture-1\\."},
    "scope": {"type":"string","minLength":1},
    "score": {"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["value","range","positive_class","interpretation","calibration_status"],"properties":{"value":{"type":["number","null"]},"range":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"}],"items":false},"positive_class":{"type":"string","minLength":1},"interpretation":{"const":"Raw model score"},"calibration_status":{"const":"Not calibrated"}}}]},
    "location": {"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["kind","start_ms","end_ms"],"properties":{"kind":{"const":"time_range"},"start_ms":{"type":"number","minimum":0},"end_ms":{"type":"number","minimum":0}}},{"type":"object","additionalProperties":false,"required":["kind","timestamp_ms"],"properties":{"kind":{"const":"point"},"timestamp_ms":{"type":"number","minimum":0},"frame_number":{"type":"integer","minimum":0}}},{"type":"object","additionalProperties":false,"required":["kind","x","y","width","height","coordinate_space","label"],"properties":{"kind":{"const":"region"},"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1},"width":{"type":"number","exclusiveMinimum":0,"maximum":1},"height":{"type":"number","exclusiveMinimum":0,"maximum":1},"coordinate_space":{"const":"normalized"},"frame_timestamp_ms":{"type":"number","minimum":0},"label":{"const":"candidate region, not a measured mask"}}}]},
    "support_refs": {"type":"array","items":{"type":"string"}},
    "limitations": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "review_status": {"enum":["unreviewed","accepted","questioned"]},
    "error": {"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["code","message","retryable"],"properties":{"code":{"type":"string","minLength":1},"message":{"type":"string","minLength":1},"retryable":{"type":"boolean"}}}]},
    "details": {"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["kind","comparison","reference_sha256","current_sha256"],"properties":{"kind":{"const":"integrity"},"comparison":{"enum":["match","mismatch","no_reference","not_compared"]},"reference_sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"current_sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"}}},{"type":"object","additionalProperties":false,"required":["kind","manifest","content_binding","signature","signer_trust","relationship"],"properties":{"kind":{"const":"provenance"},"manifest":{"enum":["yes","no","not_assessed","unsupported"]},"content_binding":{"enum":["yes","no","not_assessed","unsupported"]},"signature":{"enum":["yes","no","not_assessed","unsupported"]},"signer_trust":{"enum":["yes","no","not_assessed","unsupported"]},"relationship":{"enum":["candidate","none","not_assessed","unsupported"]}}}]},
    "fixture": {"const":true}
  }
}
