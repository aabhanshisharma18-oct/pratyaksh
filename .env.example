# Frontend mode (values are examples; no secrets belong here)
VITE_DEV_FIXTURE=false
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_D1_API_BASE_URL=http://127.0.0.1:8000
VITE_EVALUATION_BASE_URL=http://127.0.0.1:8000/evaluation-publication
VITE_EVIDENCE_API=false

# Backend examples (set these in the backend shell, not in a production frontend build)
PRATYAKSH_DB_PATH=C:\Users\HP\Pratyaksh\backend\data\pratyaksh.db
PRATYAKSH_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PRATYAKSH_EVIDENCE_DIR=C:\Users\HP\Pratyaksh\backend\data\evidence

# Test-only. Never set these for a normal or production server.
PRATYAKSH_ENV=test
PRATYAKSH_E2E_STUB=1

# Optional case briefing (backend only; never prefix a secret with VITE_)
# Export PRUNE_API_KEY in the backend shell; the server does not auto-load this file.
PRUNE_API_KEY=
PRATYAKSH_BRIEFING_MODEL=gemini-3.5-flash-lite
